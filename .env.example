# 이 파일을 복사해서 .env 로 만들고 실제 값을 채운다. (.env 는 커밋되지 않는다)
#   cp .env.example .env
#
# ⚠️ 이 파일(.env.example)에는 실제 값을 절대 넣지 않는다. 커밋되는 파일이다.

# 열린국회정보 Open API 인증키
# https://open.assembly.go.kr → 로그인 → 마이페이지 → 인증키 발급
ASSEMBLY_API_KEY=

# 로컬 PostgreSQL (application.properties 의 기본값과 동일하면 생략 가능)
DB_URL=jdbc:postgresql://localhost:5432/ddoksi
DB_USERNAME=ddoksi
DB_PASSWORD=ddoksi
